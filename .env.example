# =============================================================================
# Backend / Agency API — copy to .env.local (dev) or set in cPanel Node.js App
# =============================================================================

# Secret for signing HttpOnly JWT sessions (min 32 chars, strong random)
# REQUIRED in production. Do not use change-me* / replace-with* placeholders.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Initial admin/agent password for seeding an empty store (min 8 chars).
# REQUIRED in production (server.cjs / instrumentation will refuse to start without it).
SEED_ADMIN_PASSWORD=

# Optional private alias for the same staff password (dev / optional).
DEMO_STAFF_PASSWORD=

# Optional: show the staff demo password on the login page (must be min 8 chars).
# Leave EMPTY in real customer deployments (vorqen.ir).
NEXT_PUBLIC_DEMO_STAFF_PASSWORD=

# Optional demo OTP for client login until a real SMS provider is wired.
# In production there is NO hardcoded fallback — leave empty unless you intentionally want demo OTP.
DEMO_OTP=

# Optional: show the client OTP on the login page (also used as server OTP when set).
# Leave EMPTY in real customer deployments.
NEXT_PUBLIC_DEMO_OTP=

# Persistence is edge-safe JSON store at data/agency.json (Node / cPanel)
# On Cloudflare Workers, data lives in-memory per isolate and is seeded on demand.
#
# Public site URL (SEO / metadata) is configured in src/config/siteConfig.ts → https://vorqen.ir
