# =============================================================================
# Backend / Agency API — copy to .env.local (dev) or set in cPanel / Parspack
# Node.js App environment variables.
#
# After a successful build, "Error: Unexpected server response: 400" in the
# host panel almost always means Start failed (wrong startup file, weak/missing
# secrets below, or binding on HOSTNAME). Fix env + Startup=server.cjs, then
# Restart. See PARSPACK_DEPLOY.md → Troubleshooting 400.
#
# Fastest host fix when secrets are empty:
#   npm run env:bootstrap
# (writes data/production.env). Fresh deploys also auto-create that file once.
# =============================================================================

# Secret for signing HttpOnly JWT sessions (min 32 chars, strong random)
# REQUIRED in production. Do not use change-me* / replace-with* placeholders.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Initial admin/agent password for seeding an empty store (min 8 chars).
# REQUIRED in production (server.cjs / instrumentation will refuse to start without it).
# Or run: npm run env:bootstrap
SEED_ADMIN_PASSWORD=

# Bind address for server.cjs (optional). Default is 0.0.0.0 — correct for Passenger.
# Do NOT set HOSTNAME for listening; on Linux that is the machine name and breaks the proxy.
# HOST=0.0.0.0
# LISTEN_HOST=0.0.0.0
# BIND_HOST=0.0.0.0

# Optional private alias for the same staff password (dev / optional).
DEMO_STAFF_PASSWORD=

# Optional: show the staff demo password on the login page (must be min 8 chars).
# Leave EMPTY in real customer deployments (vorqen.ir).
NEXT_PUBLIC_DEMO_STAFF_PASSWORD=

# Optional demo OTP for client login until a real SMS provider is wired.
# In production there is NO hardcoded fallback — leave empty unless you intentionally want demo OTP.
DEMO_OTP=

# Optional: show the client OTP on the login page (also used as server OTP when set).
# Leave EMPTY in real customer deployments.
NEXT_PUBLIC_DEMO_OTP=

# Persistence is edge-safe JSON store at data/agency.json (Node / cPanel)
# On Cloudflare Workers, data lives in-memory per isolate and is seeded on demand.
# See docs/production-data.md for guarantees and limitations.
#
# Optional override for the JSON path (tests / isolation). Leave unset in production.
# AGENCY_STORE_PATH=
#
# Production first-boot auto-seed requires explicit opt-in (empty store only):
# ALLOW_PRODUCTION_SEED=1
#
# Optional local write-time backups under <storeDir>/backups/ (not a substitute for off-box backups):
# AGENCY_STORE_BACKUP=1
# AGENCY_STORE_BACKUP_KEEP=5
#
# Public site URL (SEO / metadata) is configured in src/config/siteConfig.ts → https://vorqen.ir

# Local OpenNext/Cloudflare binding emulation (Miniflare/Wrangler) during `next dev`.
# Leave unset for ordinary UI development. Set to 1/true only when testing Workers bindings.
# Shortcut: npm run dev:opennext
# OPENNEXT_DEV=1
