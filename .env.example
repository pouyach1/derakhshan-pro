# =============================================================================
# Backend / Agency API — copy to .env.local and edit
# =============================================================================

# Secret for signing HttpOnly JWT sessions (min 32 chars, strong random)
# Required in production. Do not use change-me* placeholders when deploying.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Initial admin/agent password used ONLY when seeding an empty store
# Required for: npm run db:seed / first bootstrap. Never commit the real value.
# Min 8 characters. Staff login uses this same value (hashes sync on boot).
SEED_ADMIN_PASSWORD=

# Optional: show the staff demo password on the login page (must match SEED_ADMIN_PASSWORD).
# Leave empty in real customer deployments.
NEXT_PUBLIC_DEMO_STAFF_PASSWORD=

# Optional demo OTP for client login until a real SMS provider is wired.
# If unset, client OTP login is disabled.
DEMO_OTP=

# Optional: show the client OTP on the login page (must match DEMO_OTP).
NEXT_PUBLIC_DEMO_OTP=

# Persistence is edge-safe JSON store at data/agency.json (Node)
# On Cloudflare Workers, data lives in-memory per isolate and is seeded on demand.
