# =============================================================================
# Backend / Agency API — copy to .env.local and edit
# =============================================================================

# Secret for signing HttpOnly JWT sessions (min 32 chars)
AUTH_SECRET=change-me-to-a-long-random-secret-key-please

# Demo OTP for client login (production: wire SMS provider)
DEMO_OTP=1234

# Persistence is edge-safe JSON store at data/agency.json (Node)
# On Cloudflare Workers, data lives in-memory per isolate and is seeded on demand.
